{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_TENANT_ID": "69c4370258ab0bfbcb2434c8",
        "EXPO_PUBLIC_ROLE_ID": "69c41fe29c99899b31d997d1"
      }
    },

    "tenant-bionova-production": {
      "environment": "production",
      "channel": "production",
      "distribution": "store",
      "developmentClient": false,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "tenant-bionova-production",
        "EXPO_PUBLIC_TENANT_ID": "69c4370258ab0bfbcb2434c8",
        "EXPO_PUBLIC_ROLE_ID": "69c41fe29c99899b31d997d1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
